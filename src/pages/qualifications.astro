---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": "#entreprise",
      "name": "Menuiserie Jean-Yves Chrétien",
      "alternateName": "Menuiserie JY Chrétien",
      "description": "Menuisier poseur à Dieulouard (Meurthe-et-Moselle) depuis 2011 : fourniture et pose de fenêtres, baies vitrées, portes d'entrée, volets, stores bannes, portes de garage, portails et garde-corps en aluminium, bois et PVC, en neuf et en rénovation.",
      "image": "/assets/logo-jy-chretien.jpeg",
      "logo": "/assets/logo-jy-chretien.jpeg",
      "telephone": "+33383241772",
      "email": "chretien.jy@wanadoo.fr",
      "foundingDate": "2011",
      "founder": { "@type": "Person", "name": "Jean-Yves Chrétien" },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "24 avenue Charles Roth",
        "postalCode": "54380",
        "addressLocality": "Dieulouard",
        "addressRegion": "Grand Est",
        "addressCountry": "FR"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 48.8436, "longitude": 6.0667 },
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "09:00", "closes": "17:30" }
      ],
      "areaServed": [
        { "@type": "City", "name": "Dieulouard" },
        { "@type": "City", "name": "Pont-à-Mousson" },
        { "@type": "City", "name": "Nancy" },
        { "@type": "City", "name": "Metz" },
        { "@type": "City", "name": "Toul" },
        { "@type": "City", "name": "Frouard" },
        { "@type": "City", "name": "Pompey" },
        { "@type": "City", "name": "Nomeny" },
        { "@type": "City", "name": "Liverdun" },
        { "@type": "City", "name": "Champigneulles" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Menuiseries",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de fenêtres" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de baies vitrées et portes-fenêtres" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de portes d'entrée" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de volets roulants et battants" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de stores bannes" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de portes de garage" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de portails et clôtures" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de garde-corps" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de pergolas" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Fourniture et pose de moustiquaires" } }
        ]
      },
      "priceRange": "Devis gratuit",
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Qualibat RGE 3511 – Fourniture et pose de menuiseries extérieures",
          "recognizedBy": { "@type": "Organization", "name": "Qualibat" },
          "validUntil": "2027-12-04"
        }
      ]
    },
    {
      "@type": "WebPage",
      "name": "Qualifications",
      "about": { "@id": "#entreprise" }
    }
  ]
});
---

<Layout
  title="Qualifications et garanties – Menuiserie JY Chrétien, Dieulouard"
  description="Qualifications, assurances et garanties de Menuiserie Jean-Yves Chrétien, menuisier poseur à Dieulouard (54)."
  schemaJson={schemaJson}
>
  <div style="font-family:'Sofia Sans',sans-serif;font-size:17px;line-height:1.55;color:#13243D;background:#fff">
    <Header client:load currentPath="/qualifications" />

    <section data-screen-label="Intro" style="max-width:1400px;margin:0 auto;padding:clamp(48px,6vw,96px) clamp(20px,4vw,56px) 0">
      <div style="display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(28px,4vw,64px);align-items:end">
        <div style="display:flex;flex-direction:column;gap:22px">
          <span style="font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#2F70B4;text-transform:uppercase">Qualifications &amp; garanties</span>
          <h1 style="margin:0;font:800 clamp(52px,6.4vw,100px)/.9 'Sofia Sans Condensed',sans-serif;letter-spacing:-.01em;text-wrap:balance">
            Des qualifications reconnues, des garanties écrites.
          </h1>
          <div style="width:120px;height:6px;background:#2F70B4;border-radius:6px"></div>
        </div>
        <p style="margin:0;max-width:460px;color:#34465E;text-wrap:pretty">
          Faire poser ses menuiseries par une entreprise qualifiée, c'est l'assurance d'un travail conforme aux règles de l'art et, pour certains travaux, l'accès aux aides à la rénovation énergétique.
        </p>
      </div>
    </section>

    <section id="rge" data-screen-label="Qualibat RGE" style="max-width:1400px;margin:0 auto;padding:clamp(56px,7vw,110px) clamp(20px,4vw,56px) 0">
      <div style="display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(28px,4vw,64px);align-items:start">
        <div style="display:flex;flex-direction:column;gap:12px">
          <div style="background:#F3F7FB;border-radius:32px;padding:clamp(28px,4vw,56px);display:flex;align-items:center;justify-content:center">
            <img src="/assets/logo-rge-qualibat.png" alt="Logo Qualibat RGE" style="width:min(260px,70%);height:auto;display:block" />
          </div>
          <a
            href="/assets/docs/certificat-rge-qualibat.pdf"
            target="_blank"
            rel="noopener"
            style="display:flex;gap:18px;align-items:center;background:#fff;border:1px solid #D5DFEA;border-radius:24px;padding:14px 22px 14px 14px;color:#13243D;transition:border-color 0.2s"
            onmouseenter="this.style.borderColor='#13243D'"
            onmouseleave="this.style.borderColor='#D5DFEA'"
          >
            <img src="/assets/docs/certificat-rge-v1.png" alt="Notification de décision Qualibat" style="width:96px;height:auto;border-radius:10px;border:1px solid #D5DFEA;display:block" />
            <span style="display:flex;flex-direction:column;gap:4px;flex:1">
              <span style="font:700 20px/1.1 'Sofia Sans Condensed',sans-serif">Décision Qualibat RGE</span>
              <span style="font:500 11px 'IBM Plex Mono',monospace;color:#4A5A70">PDF · notification du 11/12/2023</span>
            </span>
            <span style="width:44px;height:44px;border-radius:50%;background:#13243D;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0">↓</span>
          </a>
        </div>
        <div style="display:flex;flex-direction:column;gap:22px">
          <span style="font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#2F70B4;text-transform:uppercase">01 — Qualification</span>
          <h2 style="margin:0;font:700 clamp(36px,3.6vw,54px)/.98 'Sofia Sans Condensed',sans-serif;text-wrap:balance">Qualibat RGE</h2>
          <div style="width:120px;height:6px;background:#2F70B4;border-radius:6px"></div>
          <p style="margin:0;color:#34465E;text-wrap:pretty">
            La mention RGE, pour « Reconnu Garant de l'Environnement », est délivrée par Qualibat après contrôle des compétences, des assurances et des chantiers réalisés. Elle est réexaminée régulièrement.
          </p>
          <p style="margin:0;color:#34465E;text-wrap:pretty">
            Pour vous, elle a une conséquence concrète : les travaux d'isolation éligibles, comme le remplacement de fenêtres simple vitrage, doivent être réalisés par une entreprise RGE pour ouvrir droit aux aides publiques.
          </p>
          <dl style="margin:6px 0 0;display:flex;flex-direction:column;background:#F3F7FB;border-radius:22px;padding:6px 22px">
            <div style="display:grid;grid-template-columns:130px 1fr;gap:12px;padding:13px 0;border-bottom:1px solid #D5DFEA">
              <dt style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em;padding-top:3px">ORGANISME</dt>
              <dd style="margin:0;font-size:16px">Qualibat</dd>
            </div>
            <div style="display:grid;grid-template-columns:130px 1fr;gap:12px;padding:13px 0;border-bottom:1px solid #D5DFEA">
              <dt style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em;padding-top:3px">QUALIFICATION</dt>
              <dd style="margin:0;font-size:16px">3511 · Fourniture et pose de menuiseries extérieures en maison individuelle, petit collectif et petit tertiaire</dd>
            </div>
            <div style="display:grid;grid-template-columns:130px 1fr;gap:12px;padding:13px 0;border-bottom:1px solid #D5DFEA">
              <dt style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em;padding-top:3px">TRAVAUX</dt>
              <dd style="margin:0;font-size:16px">Catégorie 109 : fenêtres, volets, portes donnant sur l'extérieur</dd>
            </div>
            <div style="display:grid;grid-template-columns:130px 1fr;gap:12px;padding:13px 0;border-bottom:1px solid #D5DFEA">
              <dt style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em;padding-top:3px">N° DÉCISION</dt>
              <dd style="margin:0;font-size:16px">2389-20231205-123357</dd>
            </div>
            <div style="display:grid;grid-template-columns:130px 1fr;gap:12px;padding:13px 0;border-bottom:1px solid #D5DFEA">
              <dt style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em;padding-top:3px">VALIDITÉ</dt>
              <dd style="margin:0;font-size:16px">Jusqu'au 04/12/2027</dd>
            </div>
          </dl>
          <a
            href="https://www.qualibat.com"
            target="_blank"
            rel="noopener"
            style="align-self:flex-start;border:1px solid #13243D;color:#13243D;padding:13px 20px;border-radius:999px;font:700 15px/1 'Sofia Sans',sans-serif;transition:background 0.2s, color 0.2s"
            onmouseenter="this.style.background='#13243D'; this.style.color='#fff';"
            onmouseleave="this.style.background='transparent'; this.style.color='#13243D';"
          >
            Vérifier sur qualibat.com →
          </a>
        </div>
      </div>
    </section>

    <section id="aides" data-screen-label="Aides" style="padding:clamp(80px,9vw,140px) clamp(12px,1.5vw,20px) 0">
      <div style="max-width:1480px;margin:0 auto;background:#E6EEF7;border-radius:36px;padding:clamp(56px,6vw,96px) clamp(20px,4vw,64px)">
        <div style="display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:clamp(32px,5vw,80px);align-items:end;margin-bottom:48px">
          <div style="display:flex;flex-direction:column;gap:18px">
            <span style="font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#2F70B4;text-transform:uppercase">02 — Aides à la rénovation</span>
            <h2 style="margin:0;font:700 clamp(36px,3.6vw,54px)/.98 'Sofia Sans Condensed',sans-serif;text-wrap:balance">Ce que la qualification RGE vous ouvre</h2>
            <div style="width:120px;height:6px;background:#2F70B4;border-radius:6px"></div>
          </div>
          <p style="margin:0;max-width:560px;color:#34465E;text-wrap:pretty">
            Les montants et conditions dépendent de vos revenus, de votre logement et des travaux. Nous vous remettons les devis et factures conformes aux exigences de chaque dispositif.
          </p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px">
          <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:22px;padding:26px">
            <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">AIDE DE L'ÉTAT</span>
            <span style="font:700 24px/1.1 'Sofia Sans Condensed',sans-serif">MaPrimeRénov'</span>
            <span style="font-size:15px;color:#4A5A70;text-wrap:pretty">Aide pour les travaux de rénovation énergétique des résidences principales, selon conditions de ressources.</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:22px;padding:26px">
            <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">FOURNISSEURS D'ÉNERGIE</span>
            <span style="font:700 24px/1.1 'Sofia Sans Condensed',sans-serif">Primes CEE</span>
            <span style="font-size:15px;color:#4A5A70;text-wrap:pretty">Primes versées au titre des certificats d'économies d'énergie, cumulables sous conditions.</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:22px;padding:26px">
            <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">PRÊT</span>
            <span style="font:700 24px/1.1 'Sofia Sans Condensed',sans-serif">Éco-prêt à taux zéro</span>
            <span style="font-size:15px;color:#4A5A70;text-wrap:pretty">Prêt sans intérêts pour financer des travaux d'amélioration de la performance énergétique.</span>
          </div>
          <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:22px;padding:26px">
            <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">TVA</span>
            <span style="font:700 24px/1.1 'Sofia Sans Condensed',sans-serif">TVA à taux réduit</span>
            <span style="font-size:15px;color:#4A5A70;text-wrap:pretty">Taux réduit applicable à certains travaux de rénovation énergétique dans les logements de plus de deux ans.</span>
          </div>
        </div>
        <p style="margin:28px 0 0;font-size:14px;color:#4A5A70">
          Conditions à jour et simulation : <a href="https://france-renov.gouv.fr" target="_blank" rel="noopener" style="color:#13243D;font-weight:700;border-bottom:2px solid #2F70B4">france-renov.gouv.fr</a>
        </p>
      </div>
    </section>

    <section id="garanties" data-screen-label="Garanties" style="max-width:1400px;margin:0 auto;padding:clamp(80px,9vw,140px) clamp(20px,4vw,56px) 0">
      <div style="display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:clamp(32px,5vw,80px);align-items:end;margin-bottom:44px">
        <div style="display:flex;flex-direction:column;gap:18px">
          <span style="font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#2F70B4;text-transform:uppercase">03 — Garanties</span>
          <h2 style="margin:0;font:700 clamp(36px,3.6vw,54px)/.98 'Sofia Sans Condensed',sans-serif;text-wrap:balance">Après la pose, vous restez couvert</h2>
          <div style="width:120px;height:6px;background:#2F70B4;border-radius:6px"></div>
        </div>
        <p style="margin:0;max-width:560px;color:#34465E;text-wrap:pretty">
          Chaque chantier est couvert par les garanties légales du bâtiment, à compter de la réception des travaux. S'y ajoutent les garanties des fabricants sur les produits.
        </p>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:28px">
        <div style="display:flex;align-items:center;gap:10px;font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">
          <span style="width:1px;height:14px;background:#2F70B4"></span>
          <span style="flex:1;height:1px;background:#2F70B4"></span>
          <span>10 ANS À COMPTER DE LA RÉCEPTION</span>
          <span style="flex:1;height:1px;background:#2F70B4"></span>
          <span style="width:1px;height:14px;background:#2F70B4"></span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 8fr;gap:4px">
          <div style="height:14px;border-radius:14px 4px 4px 14px;background:#D9262C"></div>
          <div style="height:14px;border-radius:4px;background:#2F70B4"></div>
          <div style="height:14px;border-radius:4px 14px 14px 4px;background:#13243D"></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 8fr;gap:4px;font:500 11px 'IBM Plex Mono',monospace;color:#4A5A70;letter-spacing:.04em">
          <span>1 AN</span><span>2 ANS</span><span style="text-align:right">10 ANS</span>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px">
        <div style="display:flex;flex-direction:column;gap:10px;padding:24px;border-radius:22px;background:#F3F7FB">
          <span style="align-self:flex-start;background:#D9262C;color:#fff;padding:9px 14px;border-radius:999px;font:800 16px/1 'Sofia Sans Condensed',sans-serif">1 an</span>
          <span style="font:700 24px/1.1 'Sofia Sans Condensed',sans-serif">Parfait achèvement</span>
          <span style="font-size:15px;color:#4A5A70;text-wrap:pretty">Reprise de tous les désordres signalés à la réception ou dans l'année qui suit.</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;padding:24px;border-radius:22px;background:#F3F7FB">
          <span style="align-self:flex-start;background:#2F70B4;color:#fff;padding:9px 14px;border-radius:999px;font:800 16px/1 'Sofia Sans Condensed',sans-serif">2 ans</span>
          <span style="font:700 24px/1.1 'Sofia Sans Condensed',sans-serif">Bon fonctionnement</span>
          <span style="font-size:15px;color:#4A5A70;text-wrap:pretty">Équipements dissociables de l'ouvrage : poignées, motorisations, mécanismes de volets.</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;padding:24px;border-radius:22px;background:#F3F7FB">
          <span style="align-self:flex-start;background:#13243D;color:#fff;padding:9px 14px;border-radius:999px;font:800 16px/1 'Sofia Sans Condensed',sans-serif">10 ans</span>
          <span style="font:700 24px/1.1 'Sofia Sans Condensed',sans-serif">Garantie décennale</span>
          <span style="font-size:15px;color:#4A5A70;text-wrap:pretty">Dommages compromettant la solidité de l'ouvrage ou le rendant impropre à son usage. Assurée par MAAF Assurances, contrat n° 154158876 L 003, valable du 01/01/2026 au 31/12/2026.</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;padding:24px;border-radius:22px;background:#F3F7FB">
          <span style="align-self:flex-start;background:#4A5A70;color:#fff;padding:9px 14px;border-radius:999px;font:800 16px/1 'Sofia Sans Condensed',sans-serif">Fabricant</span>
          <span style="font:700 24px/1.1 'Sofia Sans Condensed',sans-serif">Garanties produits</span>
          <span style="font-size:15px;color:#4A5A70;text-wrap:pretty">Durées propres à chaque fabricant sur profilés, vitrages et moteurs.</span>
        </div>
      </div>

      <div style="margin-top:clamp(40px,5vw,64px);display:flex;flex-direction:column;gap:16px">
        <span style="font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#2F70B4;text-transform:uppercase">Documents à télécharger</span>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px">
          <a
            href="/assets/docs/attestation-decennale-2026.pdf"
            target="_blank"
            rel="noopener"
            style="display:flex;gap:18px;align-items:center;background:#fff;border:1px solid #D5DFEA;border-radius:24px;padding:14px 22px 14px 14px;color:#13243D;transition:border-color 0.2s"
            onmouseenter="this.style.borderColor='#13243D'"
            onmouseleave="this.style.borderColor='#D5DFEA'"
          >
            <img src="/assets/docs/decennale-v1.png" alt="Attestation d'assurance décennale MAAF 2026" style="width:84px;height:auto;border-radius:10px;border:1px solid #D5DFEA;display:block" />
            <span style="display:flex;flex-direction:column;gap:4px;flex:1">
              <span style="font:700 20px/1.1 'Sofia Sans Condensed',sans-serif">Attestation décennale 2026</span>
              <span style="font:500 11px 'IBM Plex Mono',monospace;color:#4A5A70">PDF · MAAF Assurances · valable jusqu'au 31/12/2026</span>
            </span>
            <span style="width:44px;height:44px;border-radius:50%;background:#13243D;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0">↓</span>
          </a>
          <a
            href="/assets/docs/certificat-rge-qualibat.pdf"
            target="_blank"
            rel="noopener"
            style="display:flex;gap:18px;align-items:center;background:#fff;border:1px solid #D5DFEA;border-radius:24px;padding:14px 22px 14px 14px;color:#13243D;transition:border-color 0.2s"
            onmouseenter="this.style.borderColor='#13243D'"
            onmouseleave="this.style.borderColor='#D5DFEA'"
          >
            <img src="/assets/docs/certificat-rge-v1.png" alt="Notification de décision Qualibat RGE" style="width:84px;height:auto;border-radius:10px;border:1px solid #D5DFEA;display:block" />
            <span style="display:flex;flex-direction:column;gap:4px;flex:1">
              <span style="font:700 20px/1.1 'Sofia Sans Condensed',sans-serif">Qualification Qualibat RGE 3511</span>
              <span style="font:500 11px 'IBM Plex Mono',monospace;color:#4A5A70">PDF · valable jusqu'au 04/12/2027</span>
            </span>
            <span style="width:44px;height:44px;border-radius:50%;background:#13243D;color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0">↓</span>
          </a>
        </div>
      </div>
    </section>

    <ContactSection />
    <Footer />
  </div>
</Layout>
