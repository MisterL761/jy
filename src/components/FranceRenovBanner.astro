<aside id="france-renov" aria-label="Information France Rénov'" style="max-width:1400px;margin:0 auto;padding:clamp(20px,2vw,28px) clamp(20px,4vw,56px) 0">
  <a
    href="https://france-renov.gouv.fr/"
    target="_blank"
    rel="noopener"
    style="display:flex;align-items:center;gap:clamp(16px,2.4vw,32px);flex-wrap:wrap;background:#fff;border:2px solid #13243D;border-radius:24px;padding:16px clamp(18px,2.4vw,28px);color:#13243D;transition:background 0.2s"
    onmouseenter="this.style.background='#F3F7FB'"
    onmouseleave="this.style.background='#fff'"
  >
    <span style="display:flex;gap:14px;align-items:center;flex-shrink:0">
      <img src="/assets/logo-republique-francaise.png" alt="République Française" style="height:80px;width:auto;display:block" />
      <img src="/assets/logo-france-renov.webp" alt="France Rénov'" style="height:72px;width:auto;display:block" />
    </span>
    <span style="flex:1 1 360px;font:600 clamp(16px,1.4vw,19px)/1.35 'Sofia Sans',sans-serif">
      Avant de vous engager, le service public vous informe gratuitement pour préparer et sécuriser votre projet : <span style="font-weight:700;text-decoration:underline;text-underline-offset:3px">www.france-renov.gouv.fr</span>
    </span>
    <span style="flex-shrink:0;width:44px;height:44px;border-radius:50%;background:#13243D;color:#fff;display:flex;align-items:center;justify-content:center;font-size:18px">↗</span>
  </a>
</aside>
