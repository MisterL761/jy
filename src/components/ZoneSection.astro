<section id="zone" data-screen-label="Zone d'intervention" style="max-width:1400px;margin:0 auto;padding:clamp(80px,9vw,140px) clamp(20px,4vw,56px) 0">
  <div style="display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:clamp(28px,4vw,64px);align-items:stretch">
    <div style="display:flex;flex-direction:column;gap:22px">
      <span style="font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#2F70B4;text-transform:uppercase">05 — Zone d'intervention</span>
      <h2 style="margin:0;font:700 clamp(36px,3.6vw,54px)/.98 'Sofia Sans Condensed',sans-serif;text-wrap:balance">Autour de Dieulouard, entre Nancy et Metz.</h2>
      <div style="width:120px;height:6px;background:#2F70B4;border-radius:6px"></div>
      <p style="margin:0;color:#34465E;text-wrap:pretty">Nous intervenons dans un rayon d'environ 30 km autour de notre atelier, en Meurthe-et-Moselle et en Moselle. Votre commune n'est pas sur la carte ? Appelez-nous, nous vous dirons si nous pouvons venir.</p>
      <div style="display:flex;flex-direction:column;gap:10px;margin-top:6px">
        <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4">PRINCIPALES VILLES</span>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <span style="background:#13243D;color:#fff;padding:10px 16px;border-radius:999px;font:700 16px/1 'Sofia Sans Condensed',sans-serif">Nancy</span>
          <span style="background:#13243D;color:#fff;padding:10px 16px;border-radius:999px;font:700 16px/1 'Sofia Sans Condensed',sans-serif">Metz</span>
          <span style="background:#13243D;color:#fff;padding:10px 16px;border-radius:999px;font:700 16px/1 'Sofia Sans Condensed',sans-serif">Pont-à-Mousson</span>
          <span style="background:#13243D;color:#fff;padding:10px 16px;border-radius:999px;font:700 16px/1 'Sofia Sans Condensed',sans-serif">Toul</span>
        </div>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Frouard</span>
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Pompey</span>
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Champigneulles</span>
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Liverdun</span>
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Custines</span>
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Nomeny</span>
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Villey-Saint-Étienne</span>
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Thiaucourt</span>
          <span style="background:#F3F7FB;padding:8px 13px;border-radius:999px;font:600 14px/1 'Sofia Sans',sans-serif">Saint-Nicolas-de-Port</span>
        </div>
      </div>
      <a
        href="tel:+33383241772"
        style="align-self:flex-start;margin-top:8px;display:flex;gap:10px;align-items:center;border:1px solid #13243D;color:#13243D;padding:13px 20px;border-radius:999px;font:700 15px/1 'Sofia Sans',sans-serif;transition:background 0.2s, color 0.2s"
        onmouseenter="this.style.background='#13243D'; this.style.color='#fff';"
        onmouseleave="this.style.background='transparent'; this.style.color='#13243D';"
      >
        Vérifier ma commune · 03 83 24 17 72
      </a>
    </div>
    <div style="position:relative;min-height:clamp(440px,46vw,640px);border-radius:28px;overflow:hidden;background:#E6EEF7">
      <iframe src="/Carte zone.html" title="Carte de la zone d'intervention" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;border:0"></iframe>
    </div>
  </div>
</section>
