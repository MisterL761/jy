---
---

<section data-screen-label="Hero" style="padding:0 clamp(10px,1.4vw,20px)">
  <div style="position:relative;min-height:clamp(640px,calc(100vh - 130px),900px);background:#E6EEF7;border-radius:32px;overflow:hidden;display:flex;align-items:stretch">
    <div style="position:absolute;inset:0;opacity:1;transition:opacity .8s ease;pointer-events:auto">
      <img
        src="/assets/showroom-exterieur.jpg"
        alt="Façade du showroom"
        style="width:100%;height:100%;object-fit:cover;display:block"
      />
    </div>
    <div style="position:relative;flex:1;display:flex;justify-content:space-between;gap:32px;padding:clamp(28px,3.5vw,56px);flex-wrap:wrap;pointer-events:none">
      <div style="display:flex;flex-direction:column;justify-content:space-between;gap:32px;max-width:740px;flex:1 1 420px">
        <div style="display:flex;flex-direction:column;gap:18px;align-items:flex-start">
          <h1 style="margin:0;font:800 clamp(52px,6.4vw,100px)/1.08 'Sofia Sans Condensed',sans-serif;letter-spacing:-.01em;color:#13243D">
            <span style="background:#fff;padding:0 16px;box-decoration-break:clone;-webkit-box-decoration-break:clone;border-radius:14px">
              Menuisier poseur à Dieulouard depuis 2011
            </span>
          </h1>
          <span style="background:#2F70B4;color:#fff;padding:12px 18px;border-radius:999px;font:600 15px/1.2 'Sofia Sans',sans-serif">
            Fenêtres, portes, volets, portails · aluminium, bois et PVC
          </span>
          <span style="background:#13243D;color:#fff;padding:12px 18px;border-radius:999px;font:600 15px/1.2 'Sofia Sans',sans-serif">
            40 ans d'expérience · Jean-Yves Chrétien
          </span>
        </div>
      </div>
      <div style="align-self:flex-end;width:min(440px,100%);background:#fff;border-radius:28px;padding:clamp(24px,2.4vw,34px);display:flex;flex-direction:column;gap:18px;pointer-events:auto;box-shadow:0 30px 60px -30px rgba(19,36,61,.45)">
        <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4">DEVIS GRATUIT À DOMICILE</span>
        <span style="font:700 30px/1.05 'Sofia Sans Condensed',sans-serif">Un projet de menuiserie ? Parlons-en.</span>
        <a href="tel:+33383241772" style="font:800 40px/1 'Sofia Sans Condensed',sans-serif;color:#13243D;letter-spacing:.01em">03 83 24 17 72</a>
        <span style="font-size:14px;color:#4A5A70">Lun – Ven 9h – 17h30 · Sam sur rendez-vous</span>
        <a
          href="#contact"
          style="align-self:flex-start;background:#D9262C;color:#fff;padding:17px 26px;border-radius:999px;font:700 16px/1 'Sofia Sans',sans-serif;transition:background 0.2s"
          onmouseenter="this.style.background='#B81E24'"
          onmouseleave="this.style.background='#D9262C'"
        >
          Contactez-nous
        </a>
      </div>
    </div>
  </div>
</section>
