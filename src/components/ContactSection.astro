<section id="contact" data-screen-label="Contact" style="padding:clamp(80px,9vw,140px) clamp(12px,1.5vw,20px) 0;scroll-margin-top:100px">
  <div style="max-width:1480px;margin:0 auto;background:#E6EEF7;border-radius:36px;padding:clamp(56px,6vw,96px) clamp(20px,4vw,64px);display:grid;grid-template-columns:minmax(0,4fr) minmax(0,8fr);gap:clamp(32px,5vw,80px)">
    <div style="display:flex;flex-direction:column;gap:22px">
      <span style="font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#2F70B4;text-transform:uppercase">08 — Contact</span>
      <h2 style="margin:0;font:700 clamp(42px,4.6vw,72px)/.94 'Sofia Sans Condensed',sans-serif">Parlons de votre projet.</h2>
      <div style="width:120px;height:6px;background:#2F70B4;border-radius:6px"></div>
      <p style="margin:0;max-width:420px;color:#34465E;text-wrap:pretty">Appelez-nous, écrivez-nous ou passez au showroom. Nous fixons ensemble une visite à domicile pour étudier votre projet et établir un devis détaillé, gratuitement.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px">
      <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:24px;padding:clamp(22px,2.4vw,32px);grid-column:1 / -1">
        <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">TÉLÉPHONE</span>
        <div style="display:flex;gap:clamp(20px,4vw,56px);flex-wrap:wrap;align-items:baseline">
          <a href="tel:+33383241772" style="display:flex;flex-direction:column;gap:4px;color:#13243D">
            <span style="font:800 clamp(36px,3.6vw,52px)/1 'Sofia Sans Condensed',sans-serif">03 83 24 17 72</span>
            <span style="font-size:14px;color:#4A5A70">Fixe · showroom</span>
          </a>
          <a href="tel:+33623038139" style="display:flex;flex-direction:column;gap:4px;color:#13243D">
            <span style="font:800 clamp(36px,3.6vw,52px)/1 'Sofia Sans Condensed',sans-serif">06 23 03 81 39</span>
            <span style="font-size:14px;color:#4A5A70">Portable · Jean-Yves Chrétien</span>
          </a>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:24px;padding:clamp(22px,2.4vw,32px)">
        <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">E-MAIL</span>
        <a href="mailto:chretien.jy@wanadoo.fr" style="font:700 clamp(20px,1.8vw,26px)/1.15 'Sofia Sans Condensed',sans-serif;color:#13243D;word-break:break-word">chretien.jy@wanadoo.fr</a>
        <span style="font-size:14px;color:#4A5A70">Envoyez-nous vos photos et dimensions, nous vous répondons rapidement.</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:24px;padding:clamp(22px,2.4vw,32px)">
        <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">SHOWROOM</span>
        <span style="font:700 clamp(20px,1.8vw,26px)/1.15 'Sofia Sans Condensed',sans-serif">24 avenue Charles Roth<br>54380 Dieulouard</span>
        <a
          href="https://www.google.com/maps/search/?api=1&amp;query=24+avenue+Charles+Roth+54380+Dieulouard"
          target="_blank"
          rel="noopener"
          style="align-self:flex-start;margin-top:4px;border:1px solid #13243D;color:#13243D;padding:11px 16px;border-radius:999px;font:700 14px/1 'Sofia Sans',sans-serif;transition:background 0.2s, color 0.2s"
          onmouseenter="this.style.background='#13243D'; this.style.color='#fff';"
          onmouseleave="this.style.background='transparent'; this.style.color='#13243D';"
        >
          Itinéraire →
        </a>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:24px;padding:clamp(22px,2.4vw,32px)">
        <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">HORAIRES</span>
        <div style="display:grid;grid-template-columns:auto 1fr;gap:6px 18px;font-size:16px">
          <span style="font-weight:700">Lundi – Vendredi</span><span>9h – 17h30</span>
          <span style="font-weight:700">Samedi</span><span>Sur rendez-vous uniquement</span>
          <span style="font-weight:700;color:#4A5A70">Dimanche</span><span style="color:#4A5A70">Fermé</span>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border-radius:24px;padding:clamp(22px,2.4vw,32px)">
        <span style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4;letter-spacing:.04em">ZONE D'INTERVENTION</span>
        <span style="font:700 clamp(20px,1.8vw,26px)/1.15 'Sofia Sans Condensed',sans-serif">Dieulouard, Pont-à-Mousson, Nancy, Metz, Toul et alentours</span>
        <a href="#zone" style="align-self:flex-start;font:700 14px 'Sofia Sans',sans-serif;color:#13243D;border-bottom:2px solid #2F70B4;padding-bottom:2px">Voir la carte</a>
      </div>
    </div>
  </div>
</section>
