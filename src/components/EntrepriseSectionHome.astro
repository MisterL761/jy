<section id="entreprise" data-screen-label="Entreprise" style="max-width:1400px;margin:0 auto;padding:clamp(80px,9vw,140px) clamp(20px,4vw,56px) 0">
  <div style="display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(28px,4vw,64px);align-items:start">
    <div style="position:relative;padding-top:clamp(60px,8vw,120px)">
      <div style="width:66%;height:clamp(420px,44vw,620px);background:#E6EEF7;border-radius:28px;overflow:hidden">
        <img src="/assets/showroom-exterieur.jpg" alt="Façade du showroom" style="width:100%;height:100%;object-fit:cover;display:block" />
      </div>
      <div style="position:absolute;right:0;top:0;width:58%;height:clamp(240px,26vw,360px);background:#E6EEF7;border-radius:28px;overflow:hidden;border:8px solid #fff;box-shadow:0 30px 60px -30px rgba(19,36,61,.35)">
        <img src="/assets/showroom-interieur-1.jpg" alt="Intérieur du showroom" style="width:100%;height:100%;object-fit:cover;display:block" />
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:22px;padding:24px 0 0 clamp(8px,2vw,24px)">
      <span style="font:500 12px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#2F70B4;text-transform:uppercase">04 — L'entreprise</span>
      <h2 style="margin:0;font:700 clamp(36px,3.6vw,54px)/.98 'Sofia Sans Condensed',sans-serif;text-wrap:balance">Une entreprise locale, installée à Dieulouard depuis 2011.</h2>
      <div style="width:120px;height:6px;background:#2F70B4;border-radius:6px"></div>
      <p style="margin:0;color:#34465E;text-wrap:pretty">Menuiserie Jean-Yves Chrétien est spécialisée dans la fourniture et la pose de fermetures pour l'habitat, en construction comme en rénovation. Son dirigeant, Jean-Yves Chrétien, avec ces 40 ans d'expérience, coordonne personnellement les travaux et réalise, avec son équipe de menuisiers, des prestations entièrement personnalisées.</p>
      <dl style="margin:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px">
        <div style="display:flex;flex-direction:column;gap:4px;background:#F3F7FB;border-radius:18px;padding:16px 18px">
          <dt style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4">SECTEUR</dt>
          <dd style="margin:0;font:700 19px/1.15 'Sofia Sans Condensed',sans-serif">Pont-à-Mousson, Frouard, Nomeny, Villey-Saint-Étienne</dd>
        </div>
        <div style="display:flex;flex-direction:column;gap:4px;background:#F3F7FB;border-radius:18px;padding:16px 18px">
          <dt style="font:500 11px 'IBM Plex Mono',monospace;color:#2F70B4">QUALIFICATION</dt>
          <dd style="margin:0;font:700 19px/1.15 'Sofia Sans Condensed',sans-serif">Qualibat RGE</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
