---
interface Props {
  title: string;
  description?: string;
  schemaJson?: string;
}

const { title, description = "Menuiserie Jean-Yves Chrétien, menuisier poseur à Dieulouard depuis 2011.", schemaJson } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  
  <!-- SEO -->
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="geo.region" content="FR-54" />
  <meta name="geo.placename" content="Dieulouard" />
  <meta name="geo.position" content="48.8436;6.0667" />
  <meta name="ICBM" content="48.8436, 6.0667" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Menuiserie Jean-Yves Chrétien" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/assets/logo-jy-chretien.jpeg" />
  
  {schemaJson && <script type="application/ld+json" set:html={schemaJson} />}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sofia+Sans+Condensed:wght@400;500;600;700;800&family=Sofia+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style is:global>
    html, body {
      margin: 0;
      padding: 0;
      background: #fff;
      color: #13243D;
      -webkit-font-smoothing: antialiased;
      scroll-behavior: smooth;
    }
    * {
      box-sizing: border-box;
    }
    a {
      color: #2F70B4;
      text-decoration: none;
    }
    a:hover {
      color: #13243D;
    }
    button {
      font: inherit;
    }
    ::selection {
      background: #2F70B4;
      color: #fff;
    }

    /* ---- Animations ---- */
    @keyframes rise {
      from { opacity: 0; transform: translateY(28px); }
      to { opacity: 1; transform: none; }
    }
    /* Hero : apparition en cascade au chargement (CSS seul) */
    [data-screen-label="Hero"] h1 { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
    [data-screen-label="Hero"] h1 ~ span:nth-of-type(1) { animation: rise .9s .18s cubic-bezier(.2,.7,.2,1) both; }
    [data-screen-label="Hero"] h1 ~ span:nth-of-type(2) { animation: rise .9s .32s cubic-bezier(.2,.7,.2,1) both; }
    [data-screen-label="Hero"] div[style*="box-shadow"] { animation: rise 1s .45s cubic-bezier(.2,.7,.2,1) both; }

    /* Apparition au défilement (posée par le script, seulement si JS actif) */
    .reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1);
      transition-delay: var(--d, 0ms);
    }
    .reveal.in { opacity: 1; transform: none; }

    /* Cartes : léger soulèvement au survol */
    .lift { transition: transform .25s ease, box-shadow .25s ease; }
    .lift:hover { transform: translateY(-5px); box-shadow: 0 22px 34px -22px rgba(19,36,61,.4); }

    .reveal.lift {
      transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1), box-shadow .25s ease;
      transition-delay: var(--d, 0ms);
    }

    /* Photos produits : zoom doux au survol */
    article[id^="produit-"] img { transition: transform .7s cubic-bezier(.2,.7,.2,1); }
    article[id^="produit-"] img:hover { transform: scale(1.05); }

    /* Header : ombre une fois la page défilée */
    header.scrolled { box-shadow: 0 10px 28px -18px rgba(19,36,61,.45); }

    /* Barre de progression de lecture */
    #scroll-progress {
      position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 100;
      background: #2F70B4; transform-origin: 0 50%; transform: scaleX(0); pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      [data-screen-label="Hero"] h1, [data-screen-label="Hero"] h1 ~ span, [data-screen-label="Hero"] div[style*="box-shadow"] { animation: none; }
      .reveal { opacity: 1; transform: none; transition: none; }
      .lift, .lift:hover { transition: none; transform: none; }
      article[id^="produit-"] img, article[id^="produit-"] img:hover { transition: none; transform: none; }
      #scroll-progress { display: none; }
    }
  </style>
</head>
<body>
  <div id="scroll-progress" aria-hidden="true"></div>
  <slot />
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Barre de progression, ombre du header, parallaxe du hero
    const bar = document.getElementById('scroll-progress');
    const heroImg = document.querySelector('[data-screen-label="Hero"] img') as HTMLElement | null;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (bar) bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(y / max, 1) : 0) + ')';
      document.querySelector('header')?.classList.toggle('scrolled', y > 8);
      if (heroImg && !reduce && y < window.innerHeight * 1.2) {
        heroImg.style.transform = 'translateY(' + Math.min(y * 0.2, 55) + 'px) scale(1.15)';
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
    }, { passive: true });
    onScroll();

    if (!reduce && 'IntersectionObserver' in window) {
      const vh = window.innerHeight;
      const targets: { el: HTMLElement; delay: number }[] = [];

      // Choisit les blocs à animer : les grands conteneurs sont découpés, les grilles s'animent carte par carte
      const collect = (el: HTMLElement, depth: number) => {
        const kids = Array.from(el.children) as HTMLElement[];
        const isGrid = getComputedStyle(el).display === 'grid';
        // Grille à cascade imposée (data-stagger = délai entre cartes, dans l'ordre du DOM)
        if (el.hasAttribute('data-stagger')) {
          const step = parseInt(el.getAttribute('data-stagger') || '') || 120;
          kids.forEach((k, i) => targets.push({ el: k, delay: i * step }));
        } else if (el.querySelector('[data-stagger]')) {
          kids.forEach((k) => collect(k, depth + 1));
        } else if (depth > 0 && isGrid && kids.length >= 3 && el.offsetHeight < vh * 1.2) {
          kids.forEach((k, i) => targets.push({ el: k, delay: Math.min(i, 6) * 90 }));
        } else if (el.offsetHeight > vh * 1.2 && depth < 4 && kids.length) {
          kids.forEach((k) => collect(k, depth + 1));
        } else {
          targets.push({ el, delay: 0 });
        }
      };
      document.querySelectorAll('section:not([data-screen-label="Hero"])').forEach((section) => {
        Array.from(section.children).forEach((c) => collect(c as HTMLElement, 0));
      });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          io.unobserve(el);
          el.classList.add('in');
          // Nettoyage : rend la main aux effets de survol une fois l'animation finie
          const delay = parseInt(el.style.getPropertyValue('--d')) || 0;
          setTimeout(() => {
            el.classList.remove('reveal', 'in');
            el.style.removeProperty('--d');
          }, 900 + delay);
        });
      }, { rootMargin: '0px 0px -8% 0px' });

      targets.forEach(({ el, delay }) => {
        // Ce qui est déjà visible au chargement reste affiché (pas de clignotement)
        if (el.getBoundingClientRect().top < vh * 0.95) return;
        el.style.setProperty('--d', delay + 'ms');
        el.classList.add('reveal');
        io.observe(el);
      });
    }

    // Cartes (fond bleu clair arrondi) : soulèvement au survol
    document.querySelectorAll('section *').forEach((node) => {
      const el = node as HTMLElement;
      if (el.children.length === 0 && el.tagName !== 'DIV') return;
      const cs = getComputedStyle(el);
      if (cs.backgroundColor === 'rgb(243, 247, 251)' && parseFloat(cs.borderTopLeftRadius) >= 18 && el.offsetHeight < 400) {
        el.classList.add('lift');
      }
    });
  </script>
</body>
</html>
